Shader "Custom/DroneSamhainEmissive"
{
    Properties
    {
        _BaseIntensity ("Emission Brightness", Range(0.5, 3.0)) = 1.0
        _ColorContrast ("Color Saturation / Gamma", Range(0.8, 2.2)) = 1.35
        _DroneRadiusScale ("Drone Size Multiplier", Range(0.2, 3.0)) = 1.0
    }

    SubShader
    {
        Tags 
        { 
            "RenderType" = "Opaque" 
            "Queue" = "Geometry" 
            "RenderPipeline" = "UniversalPipeline" 
        }

        LOD 100
        Cull Back
        ZWrite On

        Pass
        {
            Name "ForwardLit"
            Tags { "LightMode" = "UniversalForward" }

            HLSLPROGRAM
            #pragma vertex vert
            #pragma fragment frag

            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            struct Attributes
            {
                float4 positionOS : POSITION;
            };

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float3 colorRGB   : TEXCOORD0;
            };

            CBUFFER_START(UnityPerMaterial)
                float _BaseIntensity;
                float _ColorContrast;
                float _DroneRadiusScale;
            CBUFFER_END

            Varyings vert(Attributes input)
            {
                Varyings output;

                // 1. Get the drone's true center in world space
                float4x4 M = GetObjectToWorldMatrix();
                float3 worldCenter = mul(M, float4(0.0, 0.0, 0.0, 1.0)).xyz;

                // 2. Extract unnormalized (R, G, B) scale track from matrix columns
                float3 col0 = float3(M._m00, M._m10, M._m20);
                float3 col1 = float3(M._m01, M._m11, M._m21);
                float3 col2 = float3(M._m02, M._m12, M._m22);

                float sX = length(col0);
                float sY = length(col1);
                float sZ = length(col2);
                float maxScale = max(sX, max(sY, sZ));

                // 3. If scale is near zero (leaf rising invisibly), collapse vertices to zero area
                float isVisible = step(0.04, maxScale);
                float3 worldPos = worldCenter + (input.positionOS.xyz * (_DroneRadiusScale * isVisible));

                // 4. Subtract the 0.002 minimum scale epsilon so zero color channels are pure 0.0
                float3 decodedRGB = max(0.0, float3(sX, sY, sZ) - 0.002);

                output.positionCS = TransformWorldToHClip(worldPos);
                output.colorRGB   = decodedRGB;

                return output;
            }

            half4 frag(Varyings input) : SV_Target
            {
                half maxVal = max(input.colorRGB.r, max(input.colorRGB.g, input.colorRGB.b));
                if (maxVal < 0.03h)
                {
                    discard;
                }

                // Normalize by the dominant channel so _BaseIntensity never clips R at 1.0
                // while boosting G or B (which previously shifted orange -> yellow and green -> blue).
                half3 unitRGB = saturate(input.colorRGB / max(maxVal, 0.0001h));
                unitRGB = pow(unitRGB, max(0.8h, (half)_ColorContrast));

                half3 finalRGB = unitRGB * maxVal * (half)_BaseIntensity;
                return half4(finalRGB, 1.0h);
            }
            ENDHLSL
        }
    }
    FallBack "Hidden/Universal Render Pipeline/FallbackError"
}
