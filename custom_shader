Shader "Custom/DroneSamhainEmissive"
{
    Properties
    {
        _BaseIntensity ("Emission Brightness", Range(1.0, 10.0)) = 3.5
    }

    SubShader
    {
        Tags 
        { 
            "RenderType" = "Opaque" 
            "Queue" = "Geometry" 
            "RenderPipeline" = "UniversalPipeline" 
        }

        LOD 100
        Cull Back
        ZWrite On

        Pass
        {
            Name "ForwardLit"
            Tags { "LightMode" = "UniversalForward" }

            HLSLPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #pragma multi_compile_instancing

            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            struct Attributes
            {
                float4 positionOS : POSITION;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float3 colorRGB   : TEXCOORD0;
                UNITY_VERTEX_INPUT_INSTANCE_ID
            };

            CBUFFER_START(UnityPerMaterial)
                float _BaseIntensity;
            CBUFFER_END

            Varyings vert(Attributes input)
            {
                Varyings output;
                UNITY_SETUP_INSTANCE_ID(input);
                UNITY_TRANSFER_INSTANCE_ID(input, output);

                float4x4 M = GetObjectToWorldMatrix();

                // 1. Transform the origin (0,0,0) to get the drone's true center in world space
                float3 worldPivot = mul(M, float4(0.0, 0.0, 0.0, 1.0)).xyz;

                // 2. Add raw sphere vertex coordinates directly without multiplying by scale
                // This guarantees the drone is ALWAYS an undistorted 0.25m sphere (never an oval)
                float3 worldPos = worldPivot + input.positionOS.xyz;
                output.positionCS = TransformWorldToHClip(worldPos);

                // 3. Extract the baked (R, G, B) scale track mathematically from the transform axes
                float3 axisX = mul(M, float4(1.0, 0.0, 0.0, 0.0)).xyz;
                float3 axisY = mul(M, float4(0.0, 1.0, 0.0, 0.0)).xyz;
                float3 axisZ = mul(M, float4(0.0, 0.0, 1.0, 0.0)).xyz;

                output.colorRGB = float3(length(axisX), length(axisY), length(axisZ));

                return output;
            }

            half4 frag(Varyings input) : SV_Target
            {
                UNITY_SETUP_INSTANCE_ID(input);

                // If scale is near 0.0 (falling leaf repositioning phase), discard completely
                half maxVal = max(input.colorRGB.r, max(input.colorRGB.g, input.colorRGB.b));
                if (maxVal < 0.04)
                {
                    discard;
                }

                // Render exact baked color with HDR emission intensity
                half3 finalRGB = input.colorRGB * _BaseIntensity;
                return half4(finalRGB, 1.0);
            }
            ENDHLSL
        }
    }
    FallBack "Hidden/Universal Render Pipeline/FallbackError"
}
